# 仅在 NAS 部署目录复制为 .env 后填写；不要提交 .env 文件。
NVCI_PORT=8787
# 若只允许 NAS 本机反向代理访问，可改为 127.0.0.1；局域网直连保持 0.0.0.0。
NVCI_BIND_IP=0.0.0.0
# 使用至少 16 个字符的唯一强密码。
NVCI_ADMIN_PASSWORD=replace-with-a-strong-local-password
# 使用至少 32 个随机字符，可用：openssl rand -hex 32
NVCI_SESSION_SECRET=replace-with-a-long-random-session-secret
# 可选：迁移后将 NVCI 状态与资料库保存到 NAS 可见目录。
# 未设置时保持 Docker 命名卷 nvci_data；不要设置为 Docker 的内部卷路径。
# 示例：NVCI_DATA_BIND_PATH=/实际/存储空间2挂载路径/NVCI
# NVCI_DATA_BIND_PATH=
# NAS 本地自动采集器：默认启用后台队列与计划任务。
NVCI_AUTOMATION_ENABLED=true
# 后台队列检查间隔（秒），不影响每周计划的运行频率。
NVCI_AUTOMATION_POLL_SECONDS=60
# 首次部署保持 false；管理员在 NVCI 页面点击“立即运行”后才初始化本地 PDF 镜像。
NVCI_AUTOMATION_RUN_ON_START=false
